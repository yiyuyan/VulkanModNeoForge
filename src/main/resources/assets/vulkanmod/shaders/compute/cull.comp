#version 450

// One thread per potential metadata slot. gid -> (areaIdx, slot).
// Tests the section's 16^3 AABB (camera-relative) against 6 frustum planes,
// then (optionally) against the previous-frame Hi-Z depth pyramid for occlusion,
// then atomically appends a VkDrawIndexedIndirectCommand into the
// per-(area, renderType) command region and bumps its counter.

layout(local_size_x = 256) in;

const uint AREA_META_CAP    = 1536u; // must match GpuCuller.AREA_META_CAP
const uint AREA_TYPE_CMD_CAP = 512u;
const uint OPAQUE_TYPES      = 3u;

struct MetaEntry {
    ivec4 posType; // x,y,z = section origin in blocks relative to area corner; w = typeIdx (0..2)
    ivec4 draw;    // x = indexCount, y = firstIndex (-1 -> 0), z = vertexOffset, w = baseInstance
};

struct AreaInfo {
    vec3 origin;   // area corner relative to camera
    uint count;    // metadata entries in use this frame (0 if area not visible)
};

struct DrawCmd {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint baseInstance;
};

// Occlusion parameters, one per frame-in-flight (std430; struct stride 96 bytes).
struct OcclParam {
    mat4  prevViewProj;     // previous-frame view-proj, re-based to THIS frame's camera origin
    ivec2 screen;           // Hi-Z mip-0 dimensions (for footprint -> mip selection)
    int   mipCount;
    int   occlusionEnabled; // 1 = run the Hi-Z test, 0 = frustum-only (uHiZ is a dummy)
    float depthBias;        // conservative slack added to the occluder depth
};

layout(std430, binding = 0) readonly  buffer Meta   { MetaEntry meta[]; };
layout(std430, binding = 1) readonly  buffer Areas  { AreaInfo  areas[]; };
layout(std430, binding = 2) writeonly buffer Cmds   { DrawCmd   cmds[]; };
layout(std430, binding = 3)           buffer Counts { uint      counts[]; };
layout(binding = 4) uniform sampler2D uHiZ;                 // previous-frame Hi-Z pyramid (or dummy)
layout(std430, binding = 5) readonly  buffer Occl   { OcclParam occl[]; };

layout(push_constant) uniform PC {
    vec4 planes[6]; // Gribb-Hartmann planes from proj*modelView (camera-relative space)
    int  frameBase; // offset into areas[] for the current frame-in-flight
    int  frame;     // current frame-in-flight index (into occl[])
    int  _pad1;
    int  _pad2;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint areaIdx = gid / AREA_META_CAP;
    uint slot = gid % AREA_META_CAP;

    AreaInfo area = areas[uint(pc.frameBase) + areaIdx];
    if (slot >= area.count) return;

    MetaEntry e = meta[areaIdx * AREA_META_CAP + slot];
    if (e.draw.x <= 0) return; // freed/empty slot

    vec3 mn = area.origin + vec3(e.posType.xyz);
    vec3 mx = mn + 16.0;

    // p-vertex test against each plane
    for (int i = 0; i < 6; i++) {
        vec4 p = pc.planes[i];
        vec3 v = vec3(p.x > 0.0 ? mx.x : mn.x,
                      p.y > 0.0 ? mx.y : mn.y,
                      p.z > 0.0 ? mx.z : mn.z);
        if (dot(p.xyz, v) + p.w < 0.0) return;
    }

    // ---- Hi-Z occlusion test (previous-frame depth) -------------------------------------------
    OcclParam o = occl[pc.frame];
    if (o.occlusionEnabled == 1) {
        // Never cull sections at/around the camera: projection is unreliable there and the box
        // may straddle the near plane. 32 blocks ~= 2 chunks of safety margin.
        bool nearCam = all(lessThan(mn, vec3(48.0))) && all(greaterThan(mx, vec3(-48.0)));
        if (!nearCam) {
            vec3 lo = mn, hi = mx;
            vec2 smin = vec2(1e9), smax = vec2(-1e9);
            float ndcNear = 1e9;        // nearest depth of the box (standard depth: smallest)
            bool behindNear = false;
            for (int i = 0; i < 8; i++) {
                vec3 c = vec3((i & 1) == 0 ? lo.x : hi.x,
                              (i & 2) == 0 ? lo.y : hi.y,
                              (i & 4) == 0 ? lo.z : hi.z);
                vec4 clip = o.prevViewProj * vec4(c, 1.0);
                if (clip.w <= 0.0) { behindNear = true; break; } // straddles near plane -> keep
                vec3 ndc = clip.xyz / clip.w;          // Vulkan: z already in [0,1]
                vec2 uv = ndc.xy * 0.5 + 0.5;          // xy [-1,1] -> [0,1]
                smin = min(smin, uv);
                smax = max(smax, uv);
                ndcNear = min(ndcNear, ndc.z);
            }
            if (!behindNear) {
                smin = clamp(smin, vec2(0.0), vec2(1.0));
                smax = clamp(smax, vec2(0.0), vec2(1.0));
                // Pick the mip where the screen rect spans ~1 texel, so 4 taps cover it conservatively.
                vec2 rectPx = (smax - smin) * vec2(o.screen);
                float dim = max(rectPx.x, rectPx.y);
                int mip = clamp(int(ceil(log2(max(dim, 1.0)))), 0, o.mipCount - 1);
                float d0 = textureLod(uHiZ, smin, float(mip)).r;
                float d1 = textureLod(uHiZ, vec2(smax.x, smin.y), float(mip)).r;
                float d2 = textureLod(uHiZ, vec2(smin.x, smax.y), float(mip)).r;
                float d3 = textureLod(uHiZ, smax, float(mip)).r;
                float occluderFar = max(max(d0, d1), max(d2, d3));
                // Cull when the box's nearest point is behind the farthest stored occluder.
                if (ndcNear > occluderFar + o.depthBias) return;
            }
        }
    }

    uint counterIdx = areaIdx * OPAQUE_TYPES + uint(e.posType.w);
    uint dst = atomicAdd(counts[counterIdx], 1u);
    if (dst >= AREA_TYPE_CMD_CAP) return; // overflow: drawIndirectCount clamps via maxDrawCount

    cmds[counterIdx * AREA_TYPE_CMD_CAP + dst] =
        DrawCmd(uint(e.draw.x), 1u, uint(max(e.draw.y, 0)), e.draw.z, uint(e.draw.w));
}
